{
  "name": "@lyfe/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Inngest worker that runs Lyfe's DrChrono and Zus imports.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "inngest": "inngest-cli dev -u http://localhost:3020/api/inngest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1145.0",
    "@aws-sdk/client-textract": "^3.1140.0",
    "@medplum/core": "*",
    "@medplum/fhirtypes": "*",
    "inngest": "^3.27.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "tsx": "4.19.2",
    "unpdf": "^1.8.1",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "inngest-cli": "^1.4.0",
    "typescript": "5.9.3"
  }
}

# Medplum — the ClientApplication the worker acts as.
# Its ProjectMembership MUST carry the clinic AccessPolicy with an
# `organization` parameter, or every import refuses with
# "not scoped to an organization".
MEDPLUM_BASE_URL=
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Port this worker serves Inngest on.
PORT=3020

# Decrypts each clinic's stored DrChrono/Zus credentials. Inside Medplum this
# arrived as a project secret; out here the worker supplies it, which is where
# a deployed service's secrets belong anyway. Same value as the project secret.
LYFE_CREDENTIAL_ENCRYPTION_KEY=

# Inngest Cloud. Worker-side only: the app never talks to Inngest, it posts to
# this worker, which is what keeps the event key out of a browser bundle.
#   SIGNING verifies that a request to /api/inngest really came from Inngest
#   EVENT authorises this worker to send events
# Leave both unset to run against the local Dev Server instead.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Browser origins allowed to call /api/imports/bulk and /api/rag/*.
# Comma-separated.
ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------- Document RAG
# The Postgres holding the `lyfe_rag` schema — the same instance Medplum runs
# on, but the worker only ever touches its own schema. On Railway this is a
# reference to the Medplum Postgres, which resolves ONLY inside the Railway
# network: the host does not exist from a laptop, which is why the migration
# runs from inside the worker rather than as a local script.
#
# Everything the worker writes here is a DERIVED INDEX, not clinical data.
# Every row is rebuildable from a DocumentReference and its Binary, so
# `DROP SCHEMA lyfe_rag CASCADE` followed by a re-ingest loses nothing.
#
# Leave unset to run the worker without RAG: the DrChrono and Zus imports are
# unaffected, /health reports it, and the /api/rag/* endpoints answer 503.
RAG_DATABASE_URL=

# AWS, for Bedrock (embeddings) and Textract (OCR). Read by the SDK's default
# provider chain, so an instance role or a session token works too.
#   amazon.titan-embed-text-v2:0  embeddings, 1024 dimensions
#   textract:AnalyzeDocument      OCR for images and image-only PDFs
# Textract may not be granted to the identity Bedrock was provisioned for. If
# it is not, the worker degrades rather than failing: scanned documents are
# recorded as skipped and the text-extractable ones still index. See
# src/rag/ocr.ts.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
